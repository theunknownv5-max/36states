{
  "name": "thirty-six-states",
  "version": "0.1.0",
  "private": true,
  "description": "36 States - a tactical multiplayer FPS set across all 36 states of Nigeria (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c yellow,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "test": "node server/test.js"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  },
  "engines": { "node": ">=20" }
}
