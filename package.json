{
  "name": "proof-of-duty",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of Duty (POD) - tactical multiplayer FPS across all 36 states of Nigeria. Developed by Tcee.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c yellow,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "test": "node server/test.js",
    "android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0",
    "@capacitor/cli": "^6.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Tcee"
}
